{
  "name": "netonapi-client",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @neton/application-client-console dev",
    "build": "pnpm --filter @neton/application-client-console build",
    "typecheck": "pnpm registry && pnpm check:locales && pnpm --filter @neton/application-client-console typecheck && pnpm --filter @neton/application-client-runtime typecheck && pnpm --filter @neton/application-client-resource typecheck",
    "registry": "tsx scripts/generate-registry.mts",
    "check:locales": "tsx scripts/check-locales.mts",
    "budget": "tsx scripts/check-bundle-budget.mts",
    "test": "tsx --test \"scripts/**/*.test.mts\" && pnpm --filter @neton/application-client-runtime test",
    "e2e": "tsx e2e/run.mts",
    "lighthouse": "tsx scripts/lighthouse.mts",
    "vitals:report": "tsx scripts/vitals-report.mts",
    "cdn:rules": "tsx scripts/cdn-rules.mts",
    "structured-data": "tsx scripts/structured-data.mts"
  },
  "devDependencies": {
    "@adobe/structured-data-validator": "^1.7.0",
    "@marbec/web-auto-extractor": "^2.2.1",
    "@neton/application-client-contract": "workspace:*",
    "@neton/application-client-runtime": "workspace:*",
    "@types/node": "^26.6.5",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  }
}
